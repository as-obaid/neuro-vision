# OS
.DS_Store

# Secrets: the W&B key lives in .env, never in git
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data: the Kaggle rules forbid sharing it. Scans, labels, folds, predictions, caches and anything
# keyed by SeriesInstanceUID stay in $NV_STORE on /scratch. Only data/manifests/ is committed.
data/*
!data/manifests/
*.dcm
*.nii
*.nii.gz
*.npy
*.npz
*.parquet
*.csv
*.zip

# Weights and checkpoints live in $NV_STORE/runs, never in git
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Kaggle submission bundle (wheel + weights), built for a private Kaggle dataset
kaggle/build/

# Slurm logs
slurm/logs/

# W&B local run files
wandb/

# Internal docs stay local: only the top-level files in docs/ are committed
docs/*/
